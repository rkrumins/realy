# Endpoints and settings of the production pipeline (docs/production-pipeline.md lists every one).
REALY_PROFILE=production
PIPELINE=payments
KAFKA_BOOTSTRAP=REPLACE-broker-1:9096,REPLACE-broker-2:9096,REPLACE-broker-3:9096
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=payments-scoring
KAFKA_SASL_PASSWORD_FILE=/secrets/kafka-sasl-password
EVENTS_TOPIC=payments.events.raw
# the gateway scores what the Flink assembler publishes (every payment, assembled from its messages or
# passed through); without multi-message transactions, set it to payments.events.raw (or drop it)
INGRESS_TOPIC=payments.events.assembled
DECISIONS_TOPIC=payments.decisions
DLQ_TOPIC=payments.events.dlq
INGRESS_KAFKA=true
KAFKA_OFFSET_RESET=earliest
KAFKA_CONSUMERS=4
MAX_INFLIGHT=8192
REDIS_MODE=auto
MODEL_TARGET=REPLACE-model-endpoint:443
MODEL_NAME=fraud_mlp
MODEL_TLS=true
MODEL_AUTH_HEADER=authorization
MODEL_AUTH_TOKEN_FILE=/secrets/model-token
ADMIN_TOKEN_FILE=/secrets/admin-token
CONTROL_ENABLED=false
METRICS_PUBLISH=false
SCORING_CONFIG_FILE=/config/scoring.json
RULES_FILE=/config/rules.yaml
AUDIT_SPOOL=/spool/audit.spool
ON_PIPELINE_ERROR=REVIEW
DRAIN_TIMEOUT_MS=20000
