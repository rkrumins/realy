# Your infrastructure (docs/real-infrastructure.md). Copy to external.env (git-ignored) and fill in.
# Secrets: prefer *_FILE variables pointing at files mounted into the containers.

# Kafka (MSK, Confluent Cloud, Aiven, Event Hubs' Kafka endpoint, your own)
KAFKA_BOOTSTRAP=broker-1.example.com:9096,broker-2.example.com:9096
FLINK_KAFKA_BOOTSTRAP=broker-1.example.com:9096,broker-2.example.com:9096
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=pulsebench
KAFKA_SASL_PASSWORD=change-me
# verify: check the contract topics exist with enough partitions instead of creating them
REALY_KAFKA_TOPICS=verify

# Redis (ElastiCache / MemoryDB / Memorystore / Redis Enterprise; cluster mode is detected)
REDIS_URI=rediss://pulsebench:change-me@redis.example.com:6379
REDIS_MODE=auto

# Model server (Triton / KServe; any KServe v2 gRPC endpoint)
MODEL_TARGET=fraud-model.example.com:443
MODEL_NAME=fraud_mlp
MODEL_TLS=true
MODEL_AUTH_HEADER=authorization
MODEL_AUTH_TOKEN=Bearer change-me

# ClickHouse (ClickHouse Cloud / your cluster); its Kafka engine needs the broker settings too
# (docs/real-infrastructure.md#clickhouse)
CLICKHOUSE_URL=https://clickhouse.example.com:8443
CLICKHOUSE_USER=pulsebench
CLICKHOUSE_PASSWORD=change-me
