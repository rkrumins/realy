{
 "title": "realy \u2014 pipeline",
 "uid": "realy-pipeline",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus",
     "value": "Prometheus"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Decisions / s",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(realy_events_total{counter=\"decisions\"}[30s])) by (source)",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Outcomes / s (gateway)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(realy_events_total{source=\"gateway\",counter=~\"outcome_.*|degraded\"}[30s])) by (counter)",
     "legendFormat": "{{counter}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Gateway stage p99",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum(rate(realy_stage_latency_seconds_bucket{source=\"gateway\"}[30s])) by (le, stage)) * 1000",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Gateway stage p50",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(realy_stage_latency_seconds_bucket{source=\"gateway\"}[30s])) by (le, stage)) * 1000",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Model server queue / service p99",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum(rate(realy_stage_latency_seconds_bucket{source=\"model\"}[30s])) by (le, stage)) * 1000",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Flink stage p99 (state / shuffle / store write)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum(rate(realy_stage_latency_seconds_bucket{source=\"flink\"}[30s])) by (le, stage)) * 1000",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Flink checkpoint duration / size",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(flink_jobmanager_job_lastCheckpointDuration)",
     "legendFormat": "duration ms",
     "refId": "A"
    },
    {
     "expr": "max(flink_jobmanager_job_lastCheckpointSize) / 1e6",
     "legendFormat": "size MB",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Flink backpressure (ms/s)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(flink_taskmanager_job_task_backPressuredTimeMsPerSecond) by (task_name)",
     "legendFormat": "{{task_name}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "JVM GC pause p99",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum(rate(jvm_gc_pause_seconds_bucket[1m])) by (le, job)) * 1000",
     "legendFormat": "{{job}}",
     "refId": "A"
    },
    {
     "expr": "max(jvm_gc_pause_seconds_max) by (job) * 1000",
     "legendFormat": "max {{job}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Process CPU",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(process_cpu_usage) by (job)",
     "legendFormat": "{{job}}",
     "refId": "A"
    }
   ]
  }
 ]
}