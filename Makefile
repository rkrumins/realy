# realy — common workflows. `make help` lists targets.
SHELL := /bin/bash
COMPOSE := docker compose -f deploy/compose/docker-compose.yml --profile core --profile pipeline --profile analytics
VENV := .venv
PY := $(VENV)/bin/python
REALY := $(VENV)/bin/realy

.PHONY: help venv proto build test test-java test-python up up-obs down flink-reload smoke smoke-all \
        verify budget console ui train k8s k8s-validate codegen images clean

help:
	@grep -E '^[a-z0-9-]+:.*##' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-14s %s\n", $$1, $$2}'

venv: ## Create the Python venv with all extras
	python3 -m venv $(VENV) && $(VENV)/bin/pip install -q --upgrade pip && $(VENV)/bin/pip install -q -e "python[control,train,fast,dev]"

proto: ## Regenerate Python protobuf stubs (Java stubs are generated by Gradle)
	PYTHON=$(PY) scripts/gen-proto-python.sh

codegen: ## Regenerate ClickHouse DDL + contract-derived K8s manifests from contracts/
	$(PY) -m realy.codegen && $(PY) -m realy.k8s

build: ## Build all JVM artefacts (service distributions + Flink job jar)
	cd java && ./gradlew installDist :flink-job:shadowJar -q

test: test-java test-python ## Run all unit/integration tests

test-java:
	cd java && ./gradlew test -q

test-python:
	cd python && ../$(PY) -m pytest -q

up: build ## Start the local stack (Kafka, Redis, ClickHouse, gateway, mock model, Flink)
	$(COMPOSE) up -d --build

up-obs: ## Also start Prometheus + Grafana
	docker compose -f deploy/compose/docker-compose.yml --profile obs up -d

down: ## Stop the local stack
	$(COMPOSE) --profile obs down

flink-reload: build ## Restart Flink after rebuilding the job jar (jar is on the Flink system classpath)
	$(COMPOSE) up -d --force-recreate flink-jobmanager flink-taskmanager

smoke: ## 60 s, 500 TPS through the async gateway
	$(REALY) run smoke

smoke-all: ## smoke on all three topologies + calibration
	$(REALY) run echo-calibration; $(REALY) run smoke; $(REALY) run flink-inline-smoke; $(REALY) run sync-smoke

verify: ## Verify the latest run (features, CEL parity, scores, ClickHouse audit)
	$(REALY) verify $$(ls -td runs/*/ | head -1)

budget: ## Budget feasibility of every scenario (Monte Carlo)
	@for s in scenarios/*.yaml; do $(REALY) budget $$(basename $$s .yaml) || true; done

ui: ## Build the operator console UI
	cd ui && npm install && npm run build

console: ## Operator console on :8090
	$(REALY) console --port 8090

train: ## Train proxy models on the three most recent runs
	$(REALY) train $$(ls -td runs/*/ | head -3 | sed 's/^/--run /')

k8s-validate: ## Render and schema-validate the Kubernetes overlays (needs kustomize + kubeconform)
	@for o in deploy/k8s/overlays/dev deploy/k8s/overlays/gke-l4; do \
	  kustomize build $$o | kubeconform -summary -strict -kubernetes-version 1.33.0 -schema-location default \
	    -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' -; done

images: build ## Build all container images
	docker build -f deploy/docker/jvm-app.Dockerfile --build-arg APP=scoring-gateway -t realy/scoring-gateway:dev java
	docker build -f deploy/docker/jvm-app.Dockerfile --build-arg APP=mock-model-server -t realy/mock-model-server:dev java
	docker build -f deploy/docker/flink-job.Dockerfile -t realy/flink-job:dev java
	cd java && ./gradlew :load-emitter:installDist -q
	docker build -f deploy/docker/bench.Dockerfile -t realy/bench:dev .

clean: ## Remove run outputs and build dirs
	rm -rf runs java/*/build
