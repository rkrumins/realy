# realy — common workflows. `make help` lists targets.
# Docker-only (nothing else needed on the host):  make up · make down · make logs · make k8s-local
# Host development (JDK 21, Python 3.11+, Node 22):  make dev-* targets
SHELL := /bin/bash
COMPOSE_FILE := deploy/compose/docker-compose.yml
COMPOSE := docker compose -f $(COMPOSE_FILE)
COMPOSE_PROXY := $(COMPOSE) -f deploy/compose/docker-compose.proxy.yml
VENV := .venv
PY := $(VENV)/bin/python
REALY := $(VENV)/bin/realy

.PHONY: help up up-proxy up-obs down logs ps images console-shell smoke live-test k8s-local k8s-test k8s-down k8s-validate codegen docs \
        dev-venv dev-proto dev-build dev-test test test-java test-python dev-ui dev-console dev-up flink-reload \
        verify budget train clean

help:
	@grep -E '^[a-z0-9-]+:.*##' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-15s %s\n", $$1, $$2}'

# ----------------------------------------------------------------------------- Docker only
up: ## Build everything from source in Docker and start the full stack (console: http://localhost:8090)
	$(COMPOSE) up -d --build
	@echo "realy console: http://localhost:8090   (Flink UI :8081 · ClickHouse :8123)"

up-proxy: ## Same as `up` behind a TLS-intercepting proxy (REALY_BUILD_CA=<pem> HTTPS_PROXY=<url>)
	$(COMPOSE_PROXY) up -d --build

up-obs: ## Also start Prometheus (:9090) + Grafana (:3000)
	$(COMPOSE) --profile obs up -d

down: ## Stop the stack (keeps volumes: runs, worlds, checkpoints)
	$(COMPOSE) --profile obs down

logs: ## Follow logs of all services
	$(COMPOSE) logs -f --tail 100

ps: ## Service status / health
	$(COMPOSE) ps

images: ## Build all images (gateway, mock-model, flink, console) without starting
	$(COMPOSE) build

console-shell: ## Shell into the console container (realy CLI available)
	$(COMPOSE) exec console bash

live-test: ## Live acceptance: launch/steer/abort/bulk/lease/signals + restart faults, against the running stack
	deploy/compose/live-test.sh

smoke: ## Run the smoke scenario inside the console container
	$(COMPOSE) exec console realy run smoke

k8s-local: ## Build images, create a local kind/k3d/minikube cluster, deploy Kafka (3 brokers) + Flink + realy
	deploy/k8s/local-up.sh

k8s-test: ## In-cluster acceptance test: smoke, flink-inline + verify, Kafka broker failover (zero loss)
	deploy/k8s/test.sh

k8s-down: ## Delete the local cluster created by k8s-local
	deploy/k8s/local-up.sh down

k8s-validate: ## Render and schema-validate all Kubernetes overlays (needs kustomize + kubeconform)
	@for o in deploy/k8s/overlays/local deploy/k8s/overlays/local-1broker deploy/k8s/overlays/dev deploy/k8s/overlays/gke-l4; do \
	  echo "== $$o"; kustomize build $$o | kubeconform -summary -strict -kubernetes-version 1.33.0 -schema-location default \
	    -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' - || exit 1; done

# ----------------------------------------------------------------------------- host development
dev-venv: ## Create the Python venv with all extras
	python3 -m venv $(VENV) && $(VENV)/bin/pip install -q --upgrade pip && $(VENV)/bin/pip install -q -e "python[control,train,fast,dev]"

dev-proto: ## Regenerate Python protobuf stubs (Java stubs are generated by Gradle)
	PYTHON=$(PY) scripts/gen-proto-python.sh

codegen: ## Regenerate ClickHouse DDL, contract-derived K8s manifests and reference docs
	$(PY) -m realy.codegen && $(PY) -m realy.k8s && $(PY) -m realy.docsgen

docs: ## Regenerate docs/reference from the code and contracts
	$(PY) -m realy.docsgen

dev-build: ## Build JVM artefacts on the host (service distributions + Flink job jar)
	cd java && ./gradlew installDist :flink-job:shadowJar -q

test: test-java test-python ## Run all unit/integration tests on the host

test-java:
	cd java && ./gradlew test -q

test-python:
	cd python && ../$(PY) -m pytest -q

dev-ui: ## UI dev server with hot reload (proxies /api to :8090)
	cd ui && npm install && npm run dev

dev-console: ## Console API on the host (:8090) against a running stack
	$(REALY) console --port 8090

flink-reload: ## Recreate Flink after rebuilding its image
	$(COMPOSE) up -d --build --force-recreate flink-jobmanager flink-taskmanager

verify: ## Verify the latest run (inside the console container)
	$(COMPOSE) exec console sh -c 'realy verify $$(ls -td /runs/*/ | head -1)'

budget: ## Budget feasibility of every scenario (Monte Carlo, host venv)
	@for s in scenarios/*.yaml; do $(REALY) budget $$(basename $$s .yaml) || true; done

train: ## Train proxy models on the three most recent host runs
	$(REALY) train $$(ls -td runs/*/ | head -3 | sed 's/^/--run /')

clean: ## Remove host run outputs and build dirs
	rm -rf runs java/*/build ui/dist python/realy/control/static
